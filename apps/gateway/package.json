{
  "name": "@rc/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src",
    "provision-car": "tsx src/provision-car.ts",
    "register-agent-release": "tsx src/register-agent-release.ts"
  },
  "dependencies": {
    "@rc/contracts": "workspace:*",
    "@rc/database": "workspace:*",
    "@rc/device-auth": "workspace:*",
    "drizzle-orm": "0.45.2",
    "fastify": "^5.10.0",
    "postgres": "^3.4.0",
    "ws": "^8.21.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
