# Runtime
NODE_ENV=development
PORT=3001
WEB_PORT=3000
LOG_LEVEL=info
APP_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:3001

# Real state stores used in every simulation run
DATABASE_URL=postgresql://rc:rc_dev_only@localhost:5432/rc_racing
REDIS_URL=redis://localhost:6379
EDGE_DATABASE_PATH=./data/edge-outbox.db

# Adapter selection. Production startup rejects mock/simulator values.
MOCK_MODE=false
IDENTITY_PROVIDER=mock
PAYMENT_PROVIDER=mock
DEVICE_PROVIDER=simulator
TIMING_PROVIDER=simulator
CAMERA_PROVIDER=loop
PUBLIC_STREAM_PROVIDER=mediamtx
NOTIFICATION_PROVIDER=mailpit
SIMULATION_SCENARIO=normal
# Set only after the integrated acceptance matrix is evidenced.
SIMULATION_VERIFIED=false

# Local infrastructure
TURN_URL=turn:localhost:3478
TURN_USERNAME=rc-local
TURN_PASSWORD=local-only-change-me
MEDIAMTX_RTSP_URL=rtsp://localhost:8554
MEDIAMTX_RTMP_URL=rtmp://localhost:1935
MAILPIT_SMTP_URL=smtp://localhost:1025
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Production-only references. Values are injected by Secret Manager.
AUTH_SECRET=
AUTH_URL=https://rcmania.live
# Exact browser origin allowed to open the anonymous viewer-count WebSocket.
GATEWAY_VIEWER_ORIGIN=https://rcmania.live
# Generate independently from AUTH_SECRET: 32 random bytes as 64 lowercase hex characters.
AUTH_RATE_LIMIT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Server-only Resend credentials. Never prefix these with NEXT_PUBLIC_.
RESEND_API_KEY=
AUTH_EMAIL_FROM=RC Mania <accounts@updates.rcmania.live>
AUTH_SUPPORT_EMAIL=support@rcmania.live
STRIPE_RESTRICTED_KEY=
STRIPE_WEBHOOK_SECRET=
RIDE_GRANT_ED25519_PRIVATE_KEY=
RIDE_GRANT_ED25519_PUBLIC_KEY=
SENTRY_DSN=
