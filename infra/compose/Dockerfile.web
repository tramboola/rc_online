FROM node:22.20.0-bookworm-slim AS base

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH

RUN corepack enable && corepack prepare pnpm@10.33.0 --activate
WORKDIR /workspace

FROM base AS dependencies

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.base.json ./
COPY apps/web/package.json apps/web/package.json
COPY packages/contracts/package.json packages/contracts/package.json

RUN pnpm install --filter "@rc/web..." --frozen-lockfile

FROM dependencies AS builder

COPY apps/web apps/web
COPY packages/contracts packages/contracts

RUN pnpm --filter "@rc/web..." build

FROM node:22.20.0-bookworm-slim AS runner

ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0
ENV PORT=3000

RUN groupadd --gid 10001 rc && useradd --uid 10001 --gid rc --create-home rc

WORKDIR /app
COPY --from=builder --chown=rc:rc /workspace/apps/web/.next/standalone/ ./

USER 10001:10001
EXPOSE 3000

CMD ["node", "apps/web/server.js"]
