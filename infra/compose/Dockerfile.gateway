FROM node:26.8.1-bookworm-slim AS base

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate
WORKDIR /workspace

FROM base AS dependencies
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.base.json ./
COPY apps/gateway/package.json apps/gateway/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/database/package.json packages/database/package.json
COPY packages/device-auth/package.json packages/device-auth/package.json
RUN pnpm install --filter "@rc/gateway..." --frozen-lockfile

FROM dependencies AS builder
COPY apps/gateway apps/gateway
COPY packages/contracts packages/contracts
COPY packages/database packages/database
COPY packages/device-auth packages/device-auth
RUN pnpm --filter "@rc/gateway..." build

FROM node:26.8.1-bookworm-slim AS runner
ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=3002
WORKDIR /workspace
RUN groupadd --gid 10001 rc && useradd --uid 10001 --gid rc --create-home rc
COPY --from=builder --chown=rc:rc /workspace/node_modules ./node_modules
COPY --from=builder --chown=rc:rc /workspace/apps/gateway ./apps/gateway
COPY --from=builder --chown=rc:rc /workspace/packages ./packages
USER 10001:10001
EXPOSE 3002
CMD ["node", "apps/gateway/dist/main.js"]
